<%- include ('partials/header.ejs') %>

    <div class="container-fluid">
        <div class="row vh-100 p-0">
            <div class="col-7 p-0 ctn-column">
                <div class="login-left">
                    <img src="/img/mash.png" alt="mashIMG" class="img-fundo">
                    <div class="text-login">
                        <h1 class="text-login-pm">Bem-vindo de volta!
                            <p class="subtitulo text-login-sc">A automação para o seu teste de iodo.
                                Tenha a segurança que você precisa para seguir para a fervura no momento perfeito.
                            </p>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="form-login col-5 d-flex p-0 flex-column align-items-center justify-content-between">
                <form class="w-75" action="/login" method="post">
                    <h1 class="text-login-pm2 titulo mb-5">Login!</h1>
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <div class="input-container">
                            <img class="icon-absolute__left" src="/icons/email.png" alt="Icone usuario">
                            <input type="email" name="email" class="form-control" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="senha">Senha</label>
                        <div class="input-container">
                            <img class="icon-absolute__left" src="/icons/cadeado.png" alt="Icone usuario">
                            <input type="password" name="senha" class="form-control" required>
                            <button class="icon-absolute__right icons-absolute__right-olho" alt="">
                                <img src="/icons/olho.png" alt="">
                            </button>
                        </div>
                        <a class="botao__subtitulo" href="/recuperar-senha" style="color: var(--laranja);">Esqueceu a senha?</a>
                    </div>
                    <div class="d-flex justify-content-center flex-column align-items-center">
                        <button type="submit" style="text-transform: uppercase;"
                            class="botao botao__padrao bg-laranja mb-3 fw-semibold">Entrar<img src="/icons/porta.png"
                                class="img-porta"></button>
                        <p class="subtitulo">Não possui conta? <a href="/cadastro"
                                style="color: var(--laranja);">Crie agora</a></p>
                    </div>

                </form>
                <div>
                    <p class="direito-conloq">@2026 Conloq. Todos os direitos reservados.</p>
                </div>
            </div>
        </div>
    </div>

    <%- include ('partials/footer.ejs') %>